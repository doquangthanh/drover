/* The app's accent (web UI dark theme --accent), same as ACCENT_CHIP in tui_state_helpers.py. */
$drover-accent: #96b2d7;
$drover-line: $panel-lighten-2;

#root { layers: base overlay; }
#body { layer: base; width: 1fr; height: 1fr; }
#root.-wide #body { margin-left: 30; }
#sidebar { layer: overlay; dock: left; width: 30; height: 1fr; display: none; border-right: solid $drover-line; }
#root.-wide #sidebar, #root.-overlay #sidebar { display: block; }
#status { height: 1; dock: bottom; padding: 0 1; background: $panel; }
TerminalPaneView, StoppedPaneView {
    border: round $drover-line;
    border-title-color: $text-muted;
}
TerminalPaneView:focus, StoppedPaneView:focus {
    border: round $drover-accent;
    border-title-color: $drover-accent;
    border-title-style: bold;
}
/* One pane in the tab: no frame (Herdr's "auto" borders); the tab bar and status line already name it. */
SplitLayoutView.-single TerminalPaneView, SplitLayoutView.-single StoppedPaneView { border: none; }
